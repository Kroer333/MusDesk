include_guard(GLOBAL)

option(MUSDESK_PACKAGE_MEDIA_TOOLS "Include locally installed FFmpeg tools in the personal private ZIP" OFF)
set(MUSDESK_FFMPEG_LICENSE_FILE "${PROJECT_SOURCE_DIR}/tools/ffmpeg/LICENSE" CACHE FILEPATH "License of the locally packaged FFmpeg build")
set(MUSDESK_FFMPEG_BUILD_INFO_FILE "${PROJECT_SOURCE_DIR}/tools/ffmpeg/README.txt" CACHE FILEPATH "Version, source and build information of the packaged FFmpeg tools")
set(runtime_component MusDeskRuntime)
install(CODE [[
    if(NOT CMAKE_INSTALL_CONFIG_NAME STREQUAL "Release")
        message(FATAL_ERROR "MusDesk packages require --config Release or cpack -C Release.")
    endif()
]] COMPONENT ${runtime_component})
install(TARGETS MusDesk RUNTIME DESTINATION . COMPONENT ${runtime_component})
install(FILES "$<TARGET_FILE:SDL3::SDL3-shared>" DESTINATION . COMPONENT ${runtime_component})
install(FILES "${imgui_SOURCE_DIR}/misc/fonts/Roboto-Medium.ttf" DESTINATION assets COMPONENT ${runtime_component})
install(FILES "${PROJECT_SOURCE_DIR}/assets/MusDesk.png" DESTINATION assets COMPONENT ${runtime_component})
install(FILES "${PROJECT_SOURCE_DIR}/presets/soft-glow.json" "${PROJECT_SOURCE_DIR}/presets/beat-pulse.json"
    DESTINATION presets COMPONENT ${runtime_component})
install(FILES "${PROJECT_SOURCE_DIR}/README.md" "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md"
    "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/LICENSE-STATUS.txt"
    "${PROJECT_SOURCE_DIR}/CHANGELOG.md" "${PROJECT_SOURCE_DIR}/RELEASE_NOTES.md"
    DESTINATION . COMPONENT ${runtime_component})
install(DIRECTORY "${PROJECT_SOURCE_DIR}/licenses/" DESTINATION licenses COMPONENT ${runtime_component})
install(DIRECTORY "${PROJECT_SOURCE_DIR}/screenshots/" DESTINATION screenshots COMPONENT ${runtime_component})
install(FILES "${SDL3_SOURCE_DIR}/LICENSE.txt" DESTINATION licenses RENAME SDL.txt COMPONENT ${runtime_component})
install(FILES "${imgui_SOURCE_DIR}/LICENSE.txt" DESTINATION licenses RENAME Dear-ImGui.txt COMPONENT ${runtime_component})
install(FILES "${stb_SOURCE_DIR}/LICENSE" DESTINATION licenses RENAME stb.txt COMPONENT ${runtime_component})
install(FILES "${libwebp_SOURCE_DIR}/COPYING" DESTINATION licenses RENAME libwebp.txt COMPONENT ${runtime_component})
install(FILES "${libwebp_SOURCE_DIR}/PATENTS" DESTINATION licenses RENAME libwebp-PATENTS.txt COMPONENT ${runtime_component})
install(FILES "${nlohmann_json_SOURCE_DIR}/LICENSE.MIT" DESTINATION licenses RENAME nlohmann-json.txt COMPONENT ${runtime_component})

if(MSVC)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_COMPONENT ${runtime_component})
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION .)
    include(InstallRequiredSystemLibraries)
endif()
if(MUSDESK_PACKAGE_MEDIA_TOOLS)
    if(NOT MUSDESK_FFMPEG_EXECUTABLE OR NOT MUSDESK_FFPROBE_EXECUTABLE OR NOT EXISTS "${MUSDESK_FFMPEG_LICENSE_FILE}" OR NOT EXISTS "${MUSDESK_FFMPEG_BUILD_INFO_FILE}")
        message(FATAL_ERROR "Private media-tool packaging requires FFmpeg, ffprobe, the selected build's license and its source/build information.")
    endif()
    install(PROGRAMS "${MUSDESK_FFMPEG_EXECUTABLE}" "${MUSDESK_FFPROBE_EXECUTABLE}"
        DESTINATION . COMPONENT ${runtime_component})
    install(FILES "${MUSDESK_FFMPEG_LICENSE_FILE}" DESTINATION licenses RENAME FFmpeg-build.txt COMPONENT ${runtime_component})
    install(FILES "${MUSDESK_FFMPEG_BUILD_INFO_FILE}" DESTINATION licenses RENAME FFmpeg-build-info.txt COMPONENT ${runtime_component})
    file(SHA256 "${MUSDESK_FFMPEG_EXECUTABLE}" ffmpeg_hash)
    file(SHA256 "${MUSDESK_FFPROBE_EXECUTABLE}" ffprobe_hash)
    file(WRITE "${PROJECT_BINARY_DIR}/FFmpeg-binaries.sha256"
        "${ffmpeg_hash}  ffmpeg.exe\n${ffprobe_hash}  ffprobe.exe\n")
    install(FILES "${PROJECT_BINARY_DIR}/FFmpeg-binaries.sha256" DESTINATION licenses COMPONENT ${runtime_component})
    install(FILES "${PROJECT_SOURCE_DIR}/PRIVATE_PACKAGE.txt" DESTINATION . COMPONENT ${runtime_component})
endif()
set(CPACK_PACKAGE_NAME MusDesk)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
if(MUSDESK_PACKAGE_MEDIA_TOOLS)
    set(CPACK_PACKAGE_FILE_NAME "MusDesk-${PROJECT_VERSION}-private-windows-x64")
else()
    set(CPACK_PACKAGE_FILE_NAME "MusDesk-${PROJECT_VERSION}-windows-x64")
endif()
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_GENERATOR ZIP)
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_SOURCE_GENERATOR "")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};MusDesk;${runtime_component};/")
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
